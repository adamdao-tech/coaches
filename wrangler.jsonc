{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coaches",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Doplň URL raw API organizátora, až ji dostaneš (prázdné = web jede na ukázkových datech)
    "SOURCE_URL": ""
  }
}
